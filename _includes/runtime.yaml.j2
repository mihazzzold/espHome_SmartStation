# =============================================================================
# RUNTIME — платформа и связь (НЕ I2S / voice_assistant)
# =============================================================================
{% set _bp = board_profile | default({}) %}
{% set _hw = (ota_channel | default(_bp.get("ota_channel") | default("esp32c6"))) | string %}
{% if _hw == "esp32c3" %}
{% set _variant = "esp32c3" %}
{% set _default_board = _bp.get("board") | default("esp32-c3-devkitm-1") %}
{% else %}
{% set _variant = "esp32c6" %}
{% set _default_board = _bp.get("board") | default("esp32-c6-devkitc-1") %}
{% endif %}

esphome:
  name: "{{ device_name }}"
{% if name_add_mac_suffix | default(false) %}
  name_add_mac_suffix: true
{% endif %}
  friendly_name: "{{ friendly_name }}"
  min_version: 2025.5.0
  project:
    name: "{{ github_owner }}.espHome-SmartStation"
    version: "{{ firmware_version }}"
  on_boot:
    priority: -100
    then:
{% include "on_boot_ota_publish.yaml.j2" %}
  platformio_options:
    build_flags:
      - '-DSERIAL_NUMBER="{{ serial_number | default("UNKNOWN") }}"'

esp32:
  board: {{ board | default(_default_board) }}
  variant: {{ _variant }}
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_MBEDTLS_DYNAMIC_BUFFER: "y"

{% include "runtime_network_ota.yaml.j2" %}
